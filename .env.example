# StudySmartly environment variables
# Copy this file to .env for local development.
# Configure the same names in Vercel Project Settings > Environment Variables.

# ---------------------------------------------------------------------------
# Supabase — browser/client configuration (public; VITE_ values are bundled)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ---------------------------------------------------------------------------
# Supabase — server configuration
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: only needed if server-side admin operations use
# src/integrations/supabase/client.server.ts (service role bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Shared AI provider keys — server-side secrets
# ---------------------------------------------------------------------------
# At least one is needed for shared-key AI access when users have not saved
# their own Gemini/OpenRouter key in Settings. Configure both for failover.
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Required for saving/decrypting user-provided BYOK credentials.
# Must be exactly 64 hexadecimal characters (32 bytes).
# Generate with: openssl rand -hex 32
USER_AI_KEYS_ENCRYPTION_KEY=replace-with-64-character-hex-secret

# Optional: required only for the /api/generate-image endpoint.
OPENAI_API_KEY=your-openai-api-key
