{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "installCommand": "pnpm install --no-strict-peer-dependencies --no-frozen-lockfile",
  "buildCommand": "pnpm run build"
}
