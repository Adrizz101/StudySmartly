{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "installCommand": "npx pnpm@10.15.0 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@10.15.0 run build"
}
